    {
      "parameters": {
        "jsCode": "const wh = $('Webhook Local (Fase 4)').first().json.body;\nconst payload = {\n  sender: { name: 'ADIR Reformas', email: 'adirbc3@gmail.com' },\n  to: [{ email: wh.proveedor_email || '', name: wh.proveedor_nombre || '' }],\n  subject: 'Solicitud de presupuesto - ' + (wh.oficio_solicitado || '') + ' | Proyecto ADIR',\n  htmlContent: wh.html_email || ''\n};\n\nif (wh.anexo_base64 && wh.anexo_nombre) {\n  let rawBase64 = wh.anexo_base64;\n  if (rawBase64.includes(',')) {\n    rawBase64 = rawBase64.split(',')[1];\n  }\n  rawBase64 = rawBase64.replace(/\\s/g, '');\n  \n  let safeName = wh.anexo_nombre\n    .normalize('NFD')\n    .replace(/[\\u0300-\\u036f]/g, '')\n    .replace(/[^a-zA-Z0-9._-]/g, '_');\n    \n  payload.attachment = [\n    {\n      content: rawBase64,\n      name: safeName\n    }\n  ];\n}\n\nreturn [{ json: { _payload: JSON.stringify(payload) } }];"
