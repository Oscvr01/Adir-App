    {
      "parameters": {
        "jsCode": "const data = $('Parsear FIEBDC a JSON1').first().json;\nconst emailRemitente = data.propuesta_maestra?.cliente || '';\nconst idUnico = data.propuesta_maestra?.Proyecto || 'Sin referencia';\n\nconst ahora = new Date().toLocaleString('es-ES', {\n  day: '2-digit', month: '2-digit', year: 'numeric',\n  hour: '2-digit', minute: '2-digit'\n});\n\nconst htmlContent = `\n<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>BC3 Recibido</title>\n</head>\n<body style=\"margin:0;padding:0;background:#f4f7fb;font-family:'Segoe UI',Arial,sans-serif;\">\n  <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f4f7fb;padding:40px 0;\">\n    <tr>\n      <td align=\"center\">\n        <table width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:600px;width:100%;background:#ffffff;border-radius:16px;overflow:hidden;box-shadow:0 4px 24px rgba(0,45,84,0.10);\">\n\n          <tr>\n            <td style=\"background:#002D54;padding:32px 40px;text-align:center;\">\n              <div style=\"font-size:28px;font-weight:800;color:#ffffff;letter-spacing:2px;\">ADIR</div>\n              <div style=\"font-size:12px;color:#7db8d8;letter-spacing:3px;margin-top:4px;\">REFORMAS Y CONSTRUCCIÓN</div>\n            </td>\n          </tr>\n\n          <tr>\n            <td style=\"background:#0ea5e9;height:4px;\"></td>\n          </tr>\n\n          <tr>\n            <td style=\"padding:40px 40px 32px;\">\n              <p style=\"margin:0 0 8px;font-size:15px;color:#50504d;\">Estimado/a,</p>\n              <h1 style=\"margin:0 0 24px;font-size:22px;font-weight:700;color:#002D54;\">\n                ✅ Fichero BC3 recibido correctamente\n              </h1>\n\n              <p style=\"margin:0 0 24px;font-size:15px;color:#374151;line-height:1.7;\">\n                Hemos recibido y procesado su fichero BC3 en nuestro sistema.<br>\n                A continuación encontrará un resumen de la recepción:\n              </p>\n\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f0f6ff;border:1.5px solid #c7d5e6;border-radius:12px;margin-bottom:28px;\">\n                <tr>\n                  <td style=\"padding:24px 28px;\">\n                    <table width=\"100%\" cellpadding=\"0\" cellspacing=\"6\">\n                      <tr>\n                        <td style=\"font-size:13px;color:#6b7280;font-weight:600;width:140px;padding-bottom:10px;\">Referencia</td>\n                        <td style=\"font-size:14px;color:#002D54;font-weight:700;padding-bottom:10px;\">${idUnico}</td>\n                      </tr>\n                      <tr>\n                        <td style=\"font-size:13px;color:#6b7280;font-weight:600;\">Recibido el</td>\n                        <td style=\"font-size:14px;color:#1D1D1B;\">${ahora}</td>\n                      </tr>\n                    </table>\n                  </td>\n                </tr>\n              </table>\n\n              <p style=\"margin:0 0 24px;font-size:15px;color:#374151;line-height:1.7;\">\n                Nuestro equipo revisará la información y se pondrá en contacto con usted en los próximos días.\n                Si tiene alguna pregunta, no dude en responder a este correo.\n              </p>\n\n              <p style=\"margin:0;font-size:15px;color:#374151;\">Muchas gracias por confiar en <strong style=\"color:#002D54;\">ADIR Reformas</strong>.</p>\n            </td>\n          </tr>\n\n          <tr>\n            <td style=\"background:#002D54;padding:24px 40px;text-align:center;\">\n              <p style=\"margin:0;font-size:12px;color:#7db8d8;line-height:1.8;\">\n                ADIR Reformas y Construcción<br>\n                Este es un correo automático generado tras la recepción de su fichero BC3.\n              </p>\n            </td>\n          </tr>\n\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>\n`;\n\nconst payload = {\n  sender: { name: 'ADIR Reformas', email: 'adirbc3@gmail.com' },\n  to: [{ email: emailRemitente }],\n  subject: `✅ BC3 recibido correctamente – ${idUnico}`,\n  htmlContent\n};\n\nreturn [{ json: { _payload: JSON.stringify(payload) } }];"
      },
