    {
      "parameters": {
        "jsCode": "let nombreArchivo = \"\";\ntry {\n  const binaryData = $input.item.binary || {};\n  const attachmentKey = Object.keys(binaryData).find(k => k.startsWith('attachment')) || null;\n  const infoArchivo = attachmentKey ? binaryData[attachmentKey] : null;\n  nombreArchivo = infoArchivo ? (infoArchivo.fileName || infoArchivo.filename || infoArchivo.name || \"\") : \"\";\n} catch(e) {}\nif (!nombreArchivo) {\n  try {\n    const emailBinary = $node[\"EmailRead Imap1\"].binary || {};\n    const emailKey = Object.keys(emailBinary).find(k => k.startsWith('attachment')) || null;\n    const emailInfo = emailKey ? emailBinary[emailKey] : null;\n    nombreArchivo = emailInfo ? (emailInfo.fileName || emailInfo.filename || emailInfo.name || \"\") : \"\";\n  } catch(e) {}\n}\nif (!nombreArchivo) nombreArchivo = \"Presupuesto_Sin_Titulo\";\nconst tituloLimpio = nombreArchivo.replace(/\\.[^/.]+$/, \"\").trim() || \"Presupuesto\";\nconst idUnico = tituloLimpio + \"_\" + Math.floor(Date.now() / 1000);\nlet emailRemitente = \"Desconocido\";\ntry {\n  const from = $node[\"EmailRead Imap1\"].json.from;\n  if (typeof from === 'string') { const m = from.match(/<([^>]+)>/); emailRemitente = m ? m[1] : from; }\n  else if (from?.value?.[0]?.address) { emailRemitente = from.value[0].address; }\n  else if (from?.text) { const m = from.text.match(/<([^>]+)>/); emailRemitente = m ? m[1] : from.text; }\n  else if (from?.address) { emailRemitente = from.address; }\n} catch(e) { emailRemitente = \"Desconocido\"; }\nconst archivoTexto = $input.item.json.data || \"\";\nconst lines = archivoTexto.split(/\\r?\\n/);\nconst conceptos = {};\nconst relaciones = [];\nfor (const line of lines) {\n  if (!line.trim()) continue;\n  const parts = line.split('|');\n  const tag = parts[0];\n  if (tag === '~C') {\n    const codigo = parts[1]?.trim() || \"S/C\";\n    const unidad = parts[2]?.trim() || \"\";\n    let precio = parseFloat(parts[4]?.replace(',', '.') || '0');\n    conceptos[codigo] = { Capitulo: codigo, Unidad: unidad, Descripcion: parts[3]?.trim() || 'Sin descripcion', Precio: isNaN(precio) ? 0 : precio, conceptos: [] };\n  } else if (tag === '~D') {\n    const padre = parts[1]?.trim();\n    let raw_hijos = parts[2] ? parts[2].trim() : '';\n    if (raw_hijos.endsWith('\\\\')) raw_hijos = raw_hijos.slice(0, -1);\n    const items = raw_hijos.split('\\\\');\n    for (let i = 0; i < items.length; i += 3) {\n      if (items[i]) relaciones.push([padre, items[i].trim(), parseFloat(items[i+1]?.replace(',', '.') || '1') * parseFloat(items[i+2]?.replace(',', '.') || '0')]);\n    }\n  }\n}\nconst hijos = new Set();\nfor (const [p, h, q] of relaciones) {\n  if (conceptos[p] && conceptos[h]) { conceptos[p].conceptos.push({ ...conceptos[h], Cantidad: q }); hijos.add(h); }\n}\nconst filas = [];\nconst flatten = (arr) => {\n  for (const c of arr) {\n    if (!c.Capitulo) continue;\n    filas.push({ propuesta_id: idUnico, texto_partida: (c.Capitulo || \"S/C\") + '::' + (c.Descripcion || \"Sin descripcion\"), unidad: c.Unidad || \"\", cantidad: c.Cantidad || 0, precio_base_estimado: c.Precio || 0 });\n    if (c.conceptos && c.conceptos.length > 0) flatten(c.conceptos);\n  }\n};\nconst raices = Object.values(conceptos).filter(c => !hijos.has(c.Capitulo));\nflatten(raices);\nreturn [{ json: { propuesta_maestra: { Proyecto: idUnico, cliente: emailRemitente, estado: 'Pendiente', fecha_recepcion: new Date().toISOString() }, partidas_hijas: filas } }];"
      },
