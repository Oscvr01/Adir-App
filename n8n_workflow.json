    {
      "parameters": {
        "jsCode": "const solicitud = $(\"MySQL - Leer Solicitud\").first()?.json;\nif (!solicitud) { return [{ json: { html: '<html><body>Enlace no valido</body></html>' } }]; }\nif (solicitud.estado_solicitud === 'Respondido') { return [{ json: { html: '<html><body>Solicitud Cerrada</body></html>' } }]; }\nconst partidas = $input.all().map(i => i.json);\nconst normalize = (str) => str ? str.trim().toLowerCase().normalize(\"NFD\").replace(/[\\u0300-\\u036f]/g, \"\") : \"\";\nconst buscado = normalize(solicitud.oficio_solicitado);\nconst filtradas = partidas.filter(p => normalize(p.oficio_necesario) === buscado || normalize(p.oficio_asignado) === buscado);\nlet contentHtml = \"\";\nif (filtradas.length === 0) {\n  contentHtml = '<div>No hay partidas para: ' + solicitud.oficio_solicitado + '</div>';\n} else {\n  const filasHtml = filtradas.map(p => '<tr><td>' + (p.texto_partida || 'Sin descripcion') + '</td><td><input type=\"text\" name=\"precio_' + p.id + '\" required></td><td><input type=\"text\" name=\"comentario_' + p.id + '\"></td></tr>').join('');\n  contentHtml = '<form action=\"https://n8n-production-f7f7.up.railway.app/webhook/fase5-procesar\" method=\"POST\"><input type=\"hidden\" name=\"solicitud_id\" value=\"' + solicitud.id + '\"><input type=\"hidden\" name=\"proveedor_id\" value=\"' + (solicitud.proveedor_id || '') + '\"><table>' + filasHtml + '</table><button type=\"submit\">Enviar</button></form>';\n}\nconst html = '<!DOCTYPE html><html><head><meta charset=\"utf-8\"><title>Portal Proveedor</title></head><body><h1>Portal ADIR</h1>' + contentHtml + '</body></html>';\nreturn [{ json: { html } }];"
      },
