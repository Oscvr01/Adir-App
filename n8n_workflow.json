      "parameters": {
        "jsCode": "const allResults = [];\nconst fuentes = $('Parsear FIEBDC a JSON1').all();\nfor (const fuente of fuentes) {\n  const partidas = Array.isArray(fuente.json?.partidas_hijas) ? fuente.json.partidas_hijas : [];\n  for (const p of partidas) {\n    if (!p || typeof p !== 'object' || !p.propuesta_id) continue;\n    allResults.push({ json: { propuesta_id: String(p.propuesta_id), texto_partida: String(p.texto_partida || ''), unidad: String(p.unidad || ''), cantidad: Number(p.cantidad) || 0, precio_base_estimado: Number(p.precio_base_estimado) || 0 } });\n  }\n}\nreturn allResults;"
