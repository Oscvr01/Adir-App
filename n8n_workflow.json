        "jsCode": "const body = $input.item.json.body;\nconst precios = body.precios || [];\nconst solicitud_id = body.solicitud_id;\nconst proveedor_id = body.proveedor_id || null;\nif (!precios.length) return [];\nreturn precios.map(p => ({ json: { solicitud_id, proveedor_id, partida_id: p.partida_id, precio_ofertado: parseFloat(p.precio_ofertado) || 0, comentarios: p.comentarios || \"\" } }));"
