    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\n\nconst proyectoId  = body.proyectoId  || 'Sin referencia';\nconst proyectoNombre = body.proyectoNombre || proyectoId;\nconst jefeCorreo  = body.jefeCorreo  || '';\nconst jefeNombre  = body.jefeNombre  || jefeCorreo;\nconst tipo        = body.tipo        || 'revision'; // 'revision' | 'reasignacion'\n\nif (!jefeCorreo) return [];\n\nconst ahora = new Date().toLocaleString('es-ES', {\n  day: '2-digit', month: '2-digit', year: 'numeric',\n  hour: '2-digit', minute: '2-digit'\n});\n\nconst esReasignacion = tipo === 'reasignacion';\nconst accion  = esReasignacion ? 'reasignado' : 'asignado para revisión';\nconst tituloH1 = esReasignacion\n  ? '🔄 Proyecto reasignado'\n  : '📋 Nuevo proyecto pendiente de revisión';\nconst msgCuerpo = esReasignacion\n  ? `Se te ha reasignado el siguiente proyecto. Por favor, revísalo en cuanto puedas.`\n  : `Se te ha asignado el siguiente proyecto para que lo revises y valides. Por favor, accede a la aplicación cuando puedas.`;\n\nconst htmlContent = `\n<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Notificación ADIR</title>\n</head>\n<body style=\"margin:0;padding:0;background:#f4f7fb;font-family:'Segoe UI',Arial,sans-serif;\">\n  <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f4f7fb;padding:40px 0;\">\n    <tr><td align=\"center\">\n      <table width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:600px;width:100%;background:#ffffff;border-radius:16px;overflow:hidden;box-shadow:0 4px 24px rgba(0,45,84,0.10);\">\n\n        <tr>\n          <td style=\"background:#002D54;padding:28px 40px;text-align:center;\">\n            <div style=\"font-size:26px;font-weight:800;color:#ffffff;letter-spacing:2px;\">ADIR</div>\n            <div style=\"font-size:11px;color:#7db8d8;letter-spacing:3px;margin-top:4px;\">REFORMAS Y CONSTRUCCIÓN</div>\n          </td>\n        </tr>\n\n        <tr><td style=\"background:#0ea5e9;height:4px;\"></td></tr>\n\n        <tr>\n          <td style=\"padding:36px 40px 28px;\">\n            <p style=\"margin:0 0 6px;font-size:15px;color:#50504d;\">Hola, <strong>${jefeNombre}</strong></p>\n            <h1 style=\"margin:0 0 20px;font-size:20px;font-weight:700;color:#002D54;\">${tituloH1}</h1>\n\n            <p style=\"margin:0 0 24px;font-size:15px;color:#374151;line-height:1.7;\">${msgCuerpo}</p>\n\n            <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f0f6ff;border:1.5px solid #c7d5e6;border-radius:12px;margin-bottom:28px;\">\n              <tr><td style=\"padding:20px 24px;\">\n                <table width=\"100%\" cellpadding=\"0\" cellspacing=\"4\">\n                  <tr>\n                    <td style=\"font-size:12px;color:#6b7280;font-weight:600;width:130px;padding-bottom:8px;\">Proyecto</td>\n                    <td style=\"font-size:14px;color:#002D54;font-weight:700;padding-bottom:8px;\">${proyectoNombre}</td>\n                  </tr>\n                  <tr>\n                    <td style=\"font-size:12px;color:#6b7280;font-weight:600;padding-bottom:8px;\">Referencia</td>\n                    <td style=\"font-size:13px;color:#374151;padding-bottom:8px;\">${proyectoId}</td>\n                  </tr>\n                  <tr>\n                    <td style=\"font-size:12px;color:#6b7280;font-weight:600;\">Estado</td>\n                    <td style=\"font-size:13px;\"><span style=\"background:#fef9c3;color:#854d0e;padding:2px 8px;border-radius:4px;font-weight:600;\">Pendiente de revisión</span></td>\n                  </tr>\n                  <tr>\n                    <td style=\"font-size:12px;color:#6b7280;font-weight:600;padding-top:8px;\">Notificado el</td>\n                    <td style=\"font-size:13px;color:#374151;padding-top:8px;\">${ahora}</td>\n                  </tr>\n                </table>\n              </td></tr>\n            </table>\n\n            <p style=\"margin:0;font-size:14px;color:#374151;\">Accede a <strong style=\"color:#002D54;\">ADIR Reformas</strong> → Jefes de Obra para ver el detalle completo.</p>\n          </td>\n        </tr>\n\n        <tr>\n          <td style=\"background:#002D54;padding:20px 40px;text-align:center;\">\n            <p style=\"margin:0;font-size:11px;color:#7db8d8;line-height:1.8;\">\n              ADIR Reformas y Construcción · Notificación automática\n            </p>\n          </td>\n        </tr>\n\n      </table>\n    </td></tr>\n  </table>\n</body>\n</html>`;\n\nconst payload = {\n  sender: { name: 'ADIR Reformas', email: 'adirbc3@gmail.com' },\n  to: [{ email: jefeCorreo }],\n  subject: `${esReasignacion ? '🔄 Proyecto reasignado' : '📋 Nuevo proyecto para revisar'} – ${proyectoNombre}`,\n  htmlContent\n};\n\nreturn [{ json: { _payload: JSON.stringify(payload) } }];"
      },
